rules_version = '2';
// Dusit Daily: only active accounts of the team can read or write the team's data.
// An account is a users/{uid} profile with team == teamId and disabled != true.
// Profiles are created and changed only by the server (Management > บัญชีพนักงาน,
// or scripts/create-user.mjs), never from the app itself.
service cloud.firestore {
  match /databases/{database}/documents {

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isMember(teamId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().team == teamId
        && profile().get('disabled', false) == false;
    }

    // Own profile (name, role) is readable; nobody writes it from the app.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if isMember(teamId);
      allow write: if false;

      // Tasks
      match /items/{itemId} {
        allow read, delete: if isMember(teamId);
        allow create, update: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['room','guest','cat','pri','summary','action','due','dueDate','done','doneBy','doneByUid','doneAt','createdAt','by','byUid'])
          && request.resource.data.summary is string && request.resource.data.summary.size() <= 600
          && request.resource.data.action is string && request.resource.data.action.size() <= 600
          && request.resource.data.done is bool;
      }

      // Daily summaries sent to LINE, and who acknowledged them
      match /briefs/{briefId} {
        allow read, create, update: if isMember(teamId);
        allow delete: if false;
      }

      // LINE group settings, written by the server only
      match /meta/{doc} {
        allow read: if isMember(teamId);
        allow write: if false;
      }
    }
  }
}
